import torch
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import roc_curve, auc

def plot_roc_auc(y_real: torch.Tensor,
                 y_out: torch.Tensor,
                 y_yolo: torch.Tensor,
                 save_path: str,
                 title: str = "ROC"):
    """
    y_real  : torch.Tensor (N,) бинарные метки {0,1}
    y_out   : torch.Tensor (N,) непрерывные предсказания 2-stage
    y_yolo  : torch.Tensor (N,) непрерывные предсказания yolo
    save_path: куда сохранить график (напр. 'roc.png')
    """

    # -> numpy
    y_true = y_real.detach().float().cpu().numpy().ravel()
    p_out  = y_out.detach().float().cpu().numpy().ravel()
    p_yolo = y_yolo.detach().float().cpu().numpy().ravel()

    # ROC + AUC
    fpr_yolo, tpr_yolo, _ = roc_curve(y_true, p_yolo)
    auc_yolo = auc(fpr_yolo, tpr_yolo)

    fpr_out, tpr_out, _ = roc_curve(y_true, p_out)
    auc_out = auc(fpr_out, tpr_out)

    # Plot
    plt.figure(figsize=(6, 6))
    # синий: yolo
    plt.plot(fpr_yolo, tpr_yolo, color="blue", lw=2, label=f"yolo (AUC={auc_yolo:.4f})")
    # красный: 2stage
    plt.plot(fpr_out, tpr_out, color="red", lw=2, label=f"2stage (AUC={auc_out:.4f})")
    # диагональ
    plt.plot([0, 1], [0, 1], linestyle="--", color="gray", lw=1)

    plt.xlim([0.0, 1.0])
    plt.ylim([0.0, 1.05])
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.title(title)
    plt.legend(loc="lower right")

    # Текстовые подписи AUC на самом графике
    plt.text(0.05, 0.05, f"AUC yolo:   {auc_yolo:.4f}\nAUC 2stage: {auc_out:.4f}",
             transform=plt.gca().transAxes, fontsize=10,
             bbox=dict(boxstyle="round", facecolor="white", alpha=0.7, edgecolor="none"))

    plt.tight_layout()
    plt.savefig(save_path, dpi=200)
    plt.close()

    return {"auc_yolo": float(auc_yolo), "auc_2stage": float(auc_out)}